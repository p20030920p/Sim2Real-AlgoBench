Panels: []
Visualization Manager:
  Class: ""
  Displays:
    # The global costmap first, so the static map and the live path sit on top.
    - Alpha: 0.28
      Class: rviz_default_plugins/Map
      Enabled: true
      Name: GlobalCostmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Color Scheme: costmap
      Draw Behind: true
      Use Timestamp: false
    - Alpha: 1
      Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Color Scheme: map
      Draw Behind: true
      Use Timestamp: false
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: GlobalPlan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Alpha: 1
      Color: 220; 40; 40
      Line Style: Lines
      Line Width: 0.12
      Head Length: 0.0
      Head Radius: 0.0
      Shaft Length: 0.0
      Shaft Radius: 0.0
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LaserScan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Alpha: 0.5
      Color: 0; 220; 120
      Size (m): 0.03
      Style: Points
      Use Fixed Frame: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.7
  Global Options:
    Background Color: 32; 34; 38
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      Angle: 0
      Scale: 32
      Target Frame: <Fixed Frame>
      X: 3.65
      Y: 1.0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Height: 940
  Hide Left Dock: true
  Hide Right Dock: true
  Width: 940
  X: 30
  Y: 30
