<?xml version="1.0" encoding="utf-8"?>
<!-- This URDF was automatically created by SolidWorks to URDF Exporter! Originally created by Stephen Brawner (brawner@gmail.com) 
     Commit Version: 1.6.0-4-g7f85cfe  Build Version: 1.6.7995.38578
     For more information, please see http://wiki.ros.org/sw_urdf_exporter -->
<robot name="race_omni_car">
  <link name="base_footprint" />
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_footprint" />
    <child link="base_link" />
  </joint>
  <link name="base_link">
    <inertial>
      <origin xyz="0.00256577392966273 -2.77555756156289E-16 0.0129694272640288" rpy="0 0 0" />
      <mass value="0.953513468866446" />
      <inertia ixx="0.00536503959131535" ixy="-2.3039296165317E-18" ixz="5.96311194867027E-19" iyy="0.00506346103183601" iyz="-3.98105485209521E-18" izz="0.0103073505200943" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://race_description/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
      </material>
    </visual>
    <collision>
      <!-- A primitive collision hull is intentional.  The detailed SW mesh is
           non-convex and DART can let dynamic boxes penetrate deep into its
           visual outline.  This cylinder matches the measured 0.39 m chassis
           envelope while keeping contact stable at speed. -->
      <origin xyz="0 0 0.013" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.20" length="0.14" />
      </geometry>
    </collision>
  </link>
  <link name="front_wheel_link">
    <inertial>
      <origin xyz="-0.00230000000026315 2.51143550400457E-12 -4.61020110975596E-14" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.000403" ixy="0" ixz="0" iyy="0.000228" iyz="0" izz="0.000228" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://race_description/meshes/front_wheel_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.376470588235294 0.376470588235294 0.376470588235294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <!-- The detailed STL contains decorative omni rollers but they are all
             part of one rigid link, so using it for contact makes Gazebo treat
             the wheel as an irregular ordinary tyre.  A sphere gives a stable
             rolling contact; directional friction below models the rollers. -->
        <sphere radius="0.06364" />
      </geometry>
    </collision>
  </link>
  <joint name="front_wheel_joint" type="continuous">
    <origin xyz="0.193400000000002 0 -0.0305000000000001" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="front_wheel_link" />
    <axis xyz="1 0 0" />
  </joint>
  <link name="left_wheel_link">
    <inertial>
      <origin xyz="-0.00229999999880787 3.34460237283452E-12 3.01980662698043E-13" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.000403" ixy="0" ixz="0" iyy="0.000228" iyz="0" izz="0.000228" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://race_description/meshes/left_wheel_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.376470588235294 0.376470588235294 0.376470588235294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.06364" />
      </geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="-0.0967000000000021 0.167489313091914 -0.0305000000000001" rpy="0 0 2.0943951023932" />
    <parent link="base_link" />
    <child link="left_wheel_link" />
    <axis xyz="1 0 0" />
  </joint>
  <link name="right_wheel_link">
    <inertial>
      <origin xyz="-0.00230000000199732 1.0438871989038E-12 -1.31109012535546E-12" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.000403" ixy="0" ixz="0" iyy="0.000228" iyz="0" izz="0.000228" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://race_description/meshes/right_wheel_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.376470588235294 0.376470588235294 0.376470588235294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.06364" />
      </geometry>
    </collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="-0.0967000000000012 -0.167489313091915 -0.0304999999999995" rpy="0 0 -2.09439510239318" />
    <parent link="base_link" />
    <child link="right_wheel_link" />
    <axis xyz="1 0 0" />
  </joint>


  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.035" length="0.035" /></geometry>
      <material name="lidar_black"><color rgba="0.02 0.02 0.02 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.035" length="0.035" /></geometry>
    </collision>
    <inertial>
      <mass value="0.05" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0.06 0 0.16" rpy="0 0 0" />
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="0.04 0.08 0.04" /></geometry>
      <material name="camera_blue"><color rgba="0.05 0.15 0.8 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="0.04 0.08 0.04" /></geometry>
    </collision>
    <inertial>
      <mass value="0.05" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.18 0 0.12" rpy="0 0 0" />
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.08</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>/camera</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>20.0</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- Physical contact telemetry.  Fixed links are lumped into
       base_footprint by sdformat, hence the generated collision name below. -->
  <gazebo reference="base_link">
    <sensor name="chassis_contact" type="contact">
      <topic>/robot/contacts</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <contact>
        <collision>base_footprint_fixed_joint_lump__base_link_collision</collision>
        <topic>/robot/contacts</topic>
      </contact>
    </sensor>
  </gazebo>

  <gazebo reference="front_wheel_link">
    <sensor name="front_wheel_contact" type="contact">
      <topic>/robot/contacts/front_wheel</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <contact>
        <collision>front_wheel_link_collision</collision>
        <topic>/robot/contacts/front_wheel</topic>
      </contact>
    </sensor>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <sensor name="left_wheel_contact" type="contact">
      <topic>/robot/contacts/left_wheel</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <contact>
        <collision>left_wheel_link_collision</collision>
        <topic>/robot/contacts/left_wheel</topic>
      </contact>
    </sensor>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <sensor name="right_wheel_contact" type="contact">
      <topic>/robot/contacts/right_wheel</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <contact>
        <collision>right_wheel_link_collision</collision>
        <topic>/robot/contacts/right_wheel</topic>
      </contact>
    </sensor>
  </gazebo>

  <!-- The passive rollers are approximated with anisotropic contact: very
       little friction along each wheel shaft, strong traction perpendicular
       to it.  fdir1 is expressed in the wheel collision's local frame. -->
  <gazebo reference="front_wheel_link">
    <mu1>0.02</mu1>
    <mu2>2.0</mu2>
    <fdir1>1 0 0</fdir1>
  </gazebo>
  <gazebo reference="left_wheel_link">
    <mu1>0.02</mu1>
    <mu2>2.0</mu2>
    <fdir1>1 0 0</fdir1>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>0.02</mu1>
    <mu2>2.0</mu2>
    <fdir1>1 0 0</fdir1>
  </gazebo>




  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="front_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find race_bringup)/config/ros2_control_omni.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
