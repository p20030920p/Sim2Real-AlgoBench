<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="competition_world">
    <gravity>0 0 -9.8</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre</render_engine></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />

    <light name="dim_sun" type="directional">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.35 0.32 0.28 1</diffuse><specular>0.08 0.08 0.08 1</specular>
      <direction>-0.7 0.2 -0.65</direction>
    </light>
    <light name="warm_local_light" type="point">
      <cast_shadows>true</cast_shadows><pose>5 3 3 0 0 0</pose>
      <diffuse>0.85 0.58 0.35 1</diffuse><specular>0.15 0.10 0.08 1</specular>
      <attenuation><range>10</range><constant>0.6</constant><linear>0.08</linear><quadratic>0.02</quadratic></attenuation>
    </light>
    <light name="cool_local_light" type="point">
      <cast_shadows>true</cast_shadows><pose>-2 -2 2.5 0 0 0</pose>
      <diffuse>0.30 0.45 0.75 1</diffuse><specular>0.08 0.10 0.15 1</specular>
      <attenuation><range>8</range><constant>0.7</constant><linear>0.10</linear><quadratic>0.02</quadratic></attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static><link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include><uri>model://competition_map_dae</uri><pose>0 0 0 0 0 0</pose></include>

    <model name="low_grip_patch">
      <static>true</static><pose>6.2 5.5 0.004 0 0 0.008</pose><link name="link">
        <collision name="collision"><geometry><box><size>1.6 1.2 0.008</size></box></geometry><surface><friction><ode><mu>0.50</mu><mu2>0.50</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>1.6 1.2 0.008</size></box></geometry><material><ambient>0.48 0.48 0.48 1</ambient><diffuse>0.48 0.48 0.48 1</diffuse></material></visual>
      </link>
    </model>
    <model name="rough_patch">
      <static>true</static><pose>2.0 2.0 0.006 0.010 -0.008 0</pose><link name="link">
        <collision name="collision"><geometry><box><size>1.4 1.4 0.012</size></box></geometry><surface><friction><ode><mu>1.45</mu><mu2>1.25</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>1.4 1.4 0.012</size></box></geometry><material><ambient>0.52 0.52 0.52 1</ambient><diffuse>0.52 0.52 0.52 1</diffuse></material></visual>
      </link>
    </model>

    <model name="dynamic_obstacle">
      <static>false</static><pose>4 4 0.35 0 0 0</pose><link name="body">
        <inertial><mass>20</mass><inertia><ixx>0.82</ixx><iyy>0.82</iyy><izz>0.42</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.55 0.55 0.70</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 0.55 0.70</size></box></geometry><material><ambient>0.75 0.18 0.10 1</ambient><diffuse>0.85 0.22 0.12 1</diffuse></material></visual>
      </link>
      <joint name="slider" type="prismatic">
        <parent>world</parent><child>body</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-1.6</lower><upper>1.6</upper><effort>60</effort><velocity>1.4</velocity></limit></axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>slider</joint_name><topic>/dynamic_obstacle/cmd_pos</topic>
        <p_gain>220</p_gain><i_gain>0</i_gain><d_gain>60</d_gain>
        <cmd_max>60</cmd_max><cmd_min>-60</cmd_min>
      </plugin>
    </model>

    <!-- Second moving obstacle in the upper-room inner corridor.  Its
         controller sweeps it along X from 7.1 m to 9.9 m at Y=2.0 m. -->
    <model name="dynamic_obstacle_2">
      <static>false</static><pose>8.5 2.0 0.35 0 0 0</pose><link name="body">
        <inertial><mass>20</mass><inertia><ixx>0.82</ixx><iyy>0.82</iyy><izz>0.42</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.55 0.55 0.70</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 0.55 0.70</size></box></geometry><material><ambient>0.12 0.32 0.78 1</ambient><diffuse>0.15 0.40 0.90 1</diffuse></material></visual>
      </link>
      <joint name="slider" type="prismatic">
        <parent>world</parent><child>body</child>
        <axis><xyz>1 0 0</xyz><limit><lower>-1.4</lower><upper>1.4</upper><effort>60</effort><velocity>1.4</velocity></limit></axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>slider</joint_name><topic>/dynamic_obstacle_2/cmd_pos</topic>
        <p_gain>220</p_gain><i_gain>0</i_gain><d_gain>60</d_gain>
        <cmd_max>60</cmd_max><cmd_min>-60</cmd_min>
      </plugin>
    </model>
  </world>
</sdf>
